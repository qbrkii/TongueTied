rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test doc
    match /test/{docId} {
      allow read: if true;
    }

    // User root document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User's private diary entries
      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's custom challenges
      match /customChallenges/{challengeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
